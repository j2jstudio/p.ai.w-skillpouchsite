{
  "name": "skillpouch-site",
  "private": true,
  "version": "0.1.0",
  "description": "SkillPouch curated Agent Skills static MPA introduction site (XAP-11)",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "ingest": "node scripts/run-ingest.mjs",
    "codegen": "node scripts/build-pages.mjs",
    "catalogue:build": "node scripts/build-catalogue.mjs",
    "dev": "node scripts/build-catalogue.mjs --ensure && node scripts/build-pages.mjs && vite",
    "build": "node scripts/build-pages.mjs && vite build",
    "preview": "vite preview",
    "qa": "node scripts/qa-site-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm run build && pnpm run qa"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
